+//! Sequences for STM32WL3x (Cortex-M0+, BlueNRG-LP-derived system controller).
+
+use std::sync::Arc;
+
+use probe_rs_target::CoreType;
+
+use crate::core::memory_mapped_registers::MemoryMappedRegister;
+
+use crate::architecture::arm::{
+    ArmDebugInterface, ArmError, FullyQualifiedApAddress,
+    core::armv7m::Aircr,
+    memory::ArmMemoryInterface,
+    sequences::{ArmDebugSequence, cortex_m_wait_for_reset},
+};
+
+/// RCC_APB0ENR; bit 15 is DBGMCUEN, reset value 0 (RM0511 6.6.13).
+const RCC_APB0ENR: u64 = 0x4840_0054;
+const DBGMCUEN: u32 = 1 << 15;
+/// DBG_CR; POR-reset only. DBG_SLEEP = bit 0, DBG_STOP = bit 1 (RM0511 30.3.1).
+const DBG_CR: u64 = 0x4000_8000;
+
+/// Marker structure for STM32WL3x devices.
+#[derive(Debug)]
+pub struct Stm32Wl3 {}
+
+impl Stm32Wl3 {
+    /// Create the sequencer for STM32WL3x devices.
+    pub fn create() -> Arc<Self> {
+        Arc::new(Self {})
+    }
+}
+
+impl ArmDebugSequence for Stm32Wl3 {
+    fn debug_device_unlock(
+        &self,
+        interface: &mut dyn ArmDebugInterface,
+        default_ap: &FullyQualifiedApAddress,
+        _permissions: &crate::Permissions,
+    ) -> Result<(), ArmError> {
+        // With DBG_CR = 0 a WFI/WFE gates the debug clocks and SWD stops responding.
+        let mut memory = interface.memory_interface(default_ap)?;
+        let enr = memory.read_word_32(RCC_APB0ENR)?;
+        memory.write_word_32(RCC_APB0ENR, enr | DBGMCUEN)?;
+        memory.write_word_32(DBG_CR, 0b11)?;
+        Ok(())
+    }
+
+    fn reset_system(
+        &self,
+        interface: &mut dyn ArmMemoryInterface,
+        _core_type: CoreType,
+        _debug_base: Option<u64>,
+    ) -> Result<(), ArmError> {
+        let mut aircr = Aircr(0);
+        aircr.vectkey();
+        aircr.set_sysresetreq(true);
+
+        // The AIRCR write is never ACKed: the AP answers WAIT, and probes that replay
+        // the write on WAIT (ST-Link) keep re-triggering the reset. Treat it as done.
+        if let Err(e) = interface.write_word_32(Aircr::get_mmio_address(), aircr.into()) {
+            tracing::debug!("STM32WL3x: AIRCR write not acknowledged ({e}), assuming reset");
+        }
+
+        cortex_m_wait_for_reset(interface)
+    }
+}
